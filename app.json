{
  "expo": {
    "name": "Habilitate",
    "slug": "habilitate",
    "owner": "zakes20071",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "habilitate",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dt3bza.habilitate"
    },
    "android": {
      "package": "com.dt3bza.habilitate",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0D14"
      },
      "versionCode": 4
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "07b2ad77-ef31-48f0-af4d-79ccd0ea9822"
      }
    },
    "icon": "./assets/icon.png"
  }
}
